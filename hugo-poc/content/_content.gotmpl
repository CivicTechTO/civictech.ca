{{- /* One redirect page per row of _data/redirects.csv, the way
  jekyll-redirect-from writes them. */ -}}
{{- $rows := resources.Get "redirects.csv" | transform.Unmarshal }}
{{- range after 1 $rows }}
  {{- $.AddPage (dict
    "path" (strings.Trim (index . 0) "/")
    "kind" "page"
    "type" "redirect"
    "title" "Redirecting…"
    "params" (dict "target" (index . 1))
    "sitemap" (dict "disable" true)
  ) }}
{{- end }}

{{- /* One index page per tag and category namespace (/tags/topic/), which
  `make generate` wrote as files for Jekyll. */ -}}
{{- range $taxonomy, $namespaces := site.Params.namespaces }}
  {{- range $namespaces }}
    {{- $kind := cond (eq $taxonomy "tags") "Tags" "Categories" }}
    {{- $.AddPage (dict
      "path" (printf "%s/%s" $taxonomy .)
      "kind" "page"
      "type" "namespace"
      "title" (printf "%s %s" . $kind)
      "params" (dict "taxonomy" $taxonomy "namespace" .)
    ) }}
  {{- end }}
{{- end }}
